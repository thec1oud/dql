-- The design record's running example (§1.3), written in dpg's language.
SCHEMA app {
    DOMAIN email_address AS text
        CHECK (char_length(VALUE) <= 320);
    DOMAIN slug_text AS text
        CHECK (VALUE ~ '^[a-z0-9]+(-[a-z0-9]+)*$');

    TYPE post_status  AS ENUM ('draft', 'published', 'archived');
    TYPE money_amount AS (amount numeric(12,2), currency char(3));

    TABLE tenants (
        id   uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        name text NOT NULL
    );

    TABLE users (
        id            bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
        tenant_id     uuid NOT NULL REFERENCES app.tenants(id),
        email         app.email_address NOT NULL,
        display_name  varchar(80),
        password_hash text NOT NULL,
        created_at    timestamptz NOT NULL DEFAULT now(),
        updated_at    timestamptz NOT NULL DEFAULT now(),
        version       integer NOT NULL DEFAULT 1,
        CONSTRAINT users_tenant_email_key UNIQUE (tenant_id, email)
    ) {
        COLUMN tenant_id     { COMMENT '@bound'; }
        COLUMN password_hash { COMMENT '@write-only @sensitive'; }
        COLUMN created_at    { COMMENT '@immutable'; }
        COLUMN updated_at    { COMMENT '@db-updated'; }
        COLUMN version       { COMMENT '@version'; }
    }

    TABLE profiles (
        user_id  bigint PRIMARY KEY REFERENCES app.users(id),
        bio      text,
        birthday date
    );

    TABLE posts (
        id           bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        author_id    bigint NOT NULL REFERENCES app.users(id),
        editor_id    bigint REFERENCES app.users(id),
        title        text NOT NULL CHECK (char_length(title) BETWEEN 1 AND 200),
        slug         text GENERATED ALWAYS AS (lower(replace(title, ' ', '-'))) STORED,
        status       app.post_status NOT NULL DEFAULT 'draft',
        price        app.money_amount,
        labels       text[],
        published_at timestamptz,
        CONSTRAINT posts_published_check CHECK (published_at IS NULL OR status <> 'draft')
    );

    TABLE tags (
        id   bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
        name app.slug_text NOT NULL UNIQUE
    );

    TABLE post_tags (
        post_id bigint REFERENCES app.posts(id),
        tag_id  bigint REFERENCES app.tags(id),
        PRIMARY KEY (post_id, tag_id)
    );

    VIEW published_posts AS
        SELECT id, title, author_id, published_at
        FROM app.posts WHERE status = 'published' {
        COMMENT '@logical-key(id)';
    }

    FUNCTION post_score(p_id bigint) RETURNS numeric
        LANGUAGE sql STABLE STRICT AS $$ SELECT 0::numeric $$ {
        COMMENT '@public';
    }

    FUNCTION post_score(p_id bigint, window_days integer) RETURNS numeric
        LANGUAGE sql STABLE STRICT AS $$ SELECT 0::numeric $$ {
        COMMENT '@public';
    }
}
