      "triggers": [
        {
          "name": "users_updated_at",
          "sql": "CREATE TRIGGER users_updated_at AFTER UPDATE ON users FOR EACH ROW\n  WHEN NEW.updated_at = OLD.updated_at\nBEGIN\n  UPDATE users SET updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now') WHERE id = NEW.id;\nEND"
        }
