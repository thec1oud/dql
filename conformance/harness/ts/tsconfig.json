{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": ["node", "bun"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@dql/runtime": ["../../../runtime/ts/dql/dist/index"],
      "@dql/pg": ["../../../runtime/ts/dqlpg/dist/index"],
      "@dql/mysql": ["../../../runtime/ts/dqlmysql/dist/index"],
      "@dql/sqlite": ["../../../runtime/ts/dqlsqlite/dist/index"],
      "@dql/sqlserver": ["../../../runtime/ts/dqlsqlserver/dist/index"]
    }
  },
  "include": ["src", "test", "variantdb", "mysqlshopdb", "mysqlvariantdb", "mariadbshopdb", "sqliteshopdb", "sqlservershopdb"]
}
