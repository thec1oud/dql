{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@dql/runtime": ["../../../runtime/ts/dql/dist/index"],
      "@dql/pg": ["../../../runtime/ts/dqlpg/dist/index"]
    }
  },
  "include": ["shopdb"],
  "exclude": ["shopdb/*.test.ts"]
}
